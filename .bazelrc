common --cxxopt=-std=c++20
common --host_cxxopt=-std=c++20

common --enable_platform_specific_config
build:macos --features=-module_maps
# llvm turns on shared cc_library outputs, and ld64 rejects a dylib whose
# symbols resolve only in the binary (trill's SDL calls). Binaries link
# statically, so nothing needs the dylibs.
build:macos --features=-supports_dynamic_linker

try-import %workspace%/.bazelrc.user
