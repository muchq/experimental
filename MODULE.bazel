module(name = "experimental")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")

# Hermetic C/C++ toolchain: a static clang, and a glibc 2.28 sysroot on Linux,
# so nothing on the host leaks into a build.
bazel_dep(name = "llvm", version = "0.8.25")

register_toolchains("@llvm//toolchain:all")

# The hermetic macOS SDK ships a minimal framework set. Naming any framework
# replaces that default set rather than adding to it, and nothing pulls in a
# framework's own dependencies: the list is the defaults, everything SDL3, GLFW
# and raylib link, every framework their headers include in turn, and every
# framework their .tbd re-exports and symlinks point into (AVRouting from
# AVFoundation; the private FontServices from ApplicationServices). PrintCore
# keeps usr/include/cups, which the extension drops without that name and which
# ApplicationServices' headers include. A missing one surfaces only on macOS: a
# header not found, an unresolved re-export, or a dangling symlink Bazel rejects
# as an unsupported file type.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "AVFAudio",
    "AVFoundation",
    "AVRouting",
    "AppKit",
    "ApplicationServices",
    "AudioToolbox",
    "AudioUnit",
    "CFNetwork",
    "Carbon",
    "CloudKit",
    "Cocoa",
    "ColorSync",
    "CoreAudio",
    "CoreAudioTypes",
    "CoreData",
    "CoreFoundation",
    "CoreGraphics",
    "CoreHaptics",
    "CoreImage",
    "CoreLocation",
    "CoreMIDI",
    "CoreMedia",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "FontServices",
    "ForceFeedback",
    "Foundation",
    "GameController",
    "IOKit",
    "IOSurface",
    "ImageIO",
    "Kernel",
    "MediaToolbox",
    "Metal",
    "OSLog",
    "OpenGL",
    "PrintCore",
    "QuartzCore",
    "Security",
    "Symbols",
    "SystemConfiguration",
    "UniformTypeIdentifiers",
    "_LocationEssentials",
])

# Native cc rules; the X11, Wayland and ALSA headers come from the BCR too, and
# SDL loads those libraries at runtime by soname.
bazel_dep(name = "sdl3", version = "3.4.18")

# raylib's desktop backend. raylib itself is not in the BCR.
bazel_dep(name = "glfw", version = "3.4.0.bcr.4")

# glfw links xkbcommon, whose parser rules_bison generates with a helper that
# calls getenv without <cstdlib>; LLVM 23's libc++ no longer brings it in.
single_version_override(
    module_name = "rules_bison",
    patch_strip = 1,
    patches = ["//third_party:rules_bison_runfiles_cstdlib.patch"],
)

raylib = use_extension("//third_party:extensions.bzl", "raylib")
use_repo(raylib, "raylib")
